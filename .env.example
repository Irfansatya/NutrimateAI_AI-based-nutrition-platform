# NutriMate AI — Environment Configuration Example
# Copy this file to .env and fill in the actual connection strings.

# Supabase PostgreSQL Connection Strings
# 1. DATABASE_URL: Pooler connection string (Transaction mode, port 6543) for runtime queries
# e.g.: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct connection string (Session mode / port 5432) for Prisma migrations and CLI
# e.g.: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Application Settings
NODE_ENV="development"
PORT=3002

# Initial Admin Provisioning (Used once by npm run admin:provision)
INITIAL_ADMIN_EMAIL="admin01@example.com"
INITIAL_ADMIN_PASSWORD="ChangeMe#2026"
INITIAL_ADMIN_NAME="NutriMate Administrator"
