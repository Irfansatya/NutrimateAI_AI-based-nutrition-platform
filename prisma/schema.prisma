// Prisma Schema for NutriMate AI
// Documentation reference: docs/DATABASE.md & docs/API_SPEC.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum NutritionContextType {
  PREGNANCY
  BREASTFEEDING
  CHILD
}

enum ContextStatus {
  ACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
}

enum AssessmentStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}

enum PlanStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum NotificationChannel {
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum CampaignCategory {
  PREGNANCY
  BREASTFEEDING
  CHILD
}

enum CampaignStatus {
  REVIEW
  REVISION
  REJECTED
  APPROVED
  ACTIVE
  COMPLETED
  CANCELED
}

enum ReviewDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum DonationStatus {
  PENDING_PAYMENT
  PENDING_VERIFICATION
  CONFIRMED
  REJECTED
}

enum WalletTransactionType {
  CREDIT_DONATION
  DEBIT_WITHDRAWAL
}

enum WithdrawalStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum ContactMessageStatus {
  UNREPLIED
  REPLIED
}

// -------------------------------------------------------------
// USERS & IDENTITY
// -------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(255)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  // Relations
  profile                 UserProfile?
  sessions                UserSession[]
  nutritionContexts       NutritionContext[]
  nutritionPlans          NutritionPlan[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries  NotificationDelivery[]
  helpCampaigns           HelpCampaign[]           @relation("UserCampaigns")
  campaignReviews         CampaignReview[]         @relation("AdminReviews")
  donations               Donation[]               @relation("DonorDonations")
  verifiedDonations       Donation[]               @relation("AdminVerifiedDonations")
  wallet                  Wallet?
  withdrawals             Withdrawal[]             @relation("UserWithdrawals")
  processedWithdrawals    Withdrawal[]             @relation("AdminProcessedWithdrawals")
  repliedContactMessages  ContactMessage[]         @relation("AdminRepliedMessages")

  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("user_sessions")
}

model UserProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  phoneNumber     String?   @map("phone_number") @db.VarChar(32)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// -------------------------------------------------------------
// NUTRITION CONTEXTS & PROFILES
// -------------------------------------------------------------

model NutritionContext {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  contextType NutritionContextType @map("context_type")
  label       String?              @db.VarChar(128)
  status      ContextStatus        @default(ACTIVE)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pregnancyProfile     PregnancyProfile?
  breastfeedingProfile BreastfeedingProfile?
  childProfile         ChildProfile?
  assessments          NutritionAssessment[]

  @@index([userId])
  @@index([userId, contextType])
  @@map("nutrition_contexts")
}

model PregnancyProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  contextId           String    @unique @map("context_id") @db.Uuid
  gestationalAgeWeeks Int?      @map("gestational_age_weeks")
  pregnancyIndex      Int?      @map("pregnancy_index")
  prePregnancyWeight  Decimal?  @map("pre_pregnancy_weight") @db.Decimal(5, 2)
  estimatedDueDate    DateTime? @map("estimated_due_date") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  context NutritionContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@map("pregnancy_profiles")
}

model BreastfeedingProfile {
  id            String    @id @default(uuid()) @db.Uuid
  contextId     String    @unique @map("context_id") @db.Uuid
  babyAgeMonths Int?      @map("baby_age_months")
  deliveryDate  DateTime? @map("delivery_date") @db.Date
  childIndex    Int?      @map("child_index")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  context NutritionContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@map("breastfeeding_profiles")
}

model ChildProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  contextId             String    @unique @map("context_id") @db.Uuid
  childName             String?   @map("child_name") @db.VarChar(128)
  gender                Gender?
  birthDate             DateTime? @map("birth_date") @db.Date
  currentAgeMonths      Int?      @map("current_age_months")
  birthWeight           Decimal?  @map("birth_weight") @db.Decimal(5, 2)
  birthLength           Decimal?  @map("birth_length") @db.Decimal(5, 2)
  isPremature           Boolean   @default(false) @map("is_premature")
  gestationalAgeAtBirth Int?      @map("gestational_age_at_birth")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  context NutritionContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@map("child_profiles")
}

// -------------------------------------------------------------
// NUTRICHECK & NUTRIPLAN
// -------------------------------------------------------------

model NutritionAssessment {
  id              String           @id @default(uuid()) @db.Uuid
  contextId       String           @map("context_id") @db.Uuid
  periodKey       String           @map("period_key") @db.VarChar(16)
  version         Int              @default(1)
  isBaseline      Boolean          @default(false) @map("is_baseline")
  status          AssessmentStatus @default(COMPLETED)
  economicData    Json?            @map("economic_data")
  healthData      Json?            @map("health_data")
  environmentData Json?            @map("environment_data")
  contextSnapshot Json?            @map("context_snapshot")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(6)

  // Relations
  context NutritionContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  plans   NutritionPlan[]

  @@index([contextId])
  @@index([contextId, periodKey])
  @@index([createdAt])
  @@map("nutrition_assessments")
}

model NutritionPlan {
  id              String               @id @default(uuid()) @db.Uuid
  assessmentId    String               @map("assessment_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  category        NutritionContextType
  version         Int                  @default(1)
  periodStart     DateTime             @map("period_start") @db.Date
  periodEnd       DateTime             @map("period_end") @db.Date
  dailyBudget     Decimal              @map("daily_budget") @db.Decimal(12, 2)
  targetNutrition String?              @map("target_nutrition") @db.Text
  status          PlanStatus           @default(READY)
  modelProvider   String?              @map("model_provider") @db.VarChar(64)
  modelName       String?              @map("model_name") @db.VarChar(64)
  adjustmentNotes String?              @map("adjustment_notes") @db.Text
  isApproved      Boolean              @default(false) @map("is_approved")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt         DateTime?            @map("ready_at") @db.Timestamptz(6)

  // Relations
  assessment           NutritionAssessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRecommendations DailyRecommendation[]

  @@index([assessmentId])
  @@index([userId])
  @@index([status])
  @@index([periodStart])
  @@map("nutrition_plans")
}

model DailyRecommendation {
  id                 String   @id @default(uuid()) @db.Uuid
  planId             String   @map("plan_id") @db.Uuid
  recommendationDate DateTime @map("recommendation_date") @db.Date
  dayIndex           Int      @map("day_index")
  totalCalories      Decimal? @map("total_calories") @db.Decimal(7, 2)
  estimatedCost      Decimal  @map("estimated_cost") @db.Decimal(12, 2)
  isOverBudget       Boolean  @default(false) @map("is_over_budget")
  dailyTips          String?  @map("daily_tips") @db.Text
  mealsData          Json     @map("meals_data")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  plan                   NutritionPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  notificationDeliveries NotificationDelivery[]

  @@unique([planId, recommendationDate])
  @@index([planId])
  @@index([recommendationDate])
  @@map("daily_recommendations")
}

// -------------------------------------------------------------
// NUTRIDAILY — NOTIFICATIONS
// -------------------------------------------------------------

model NotificationPreference {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  channel       NotificationChannel @default(WHATSAPP)
  enabled       Boolean             @default(true)
  preferredTime String?             @map("preferred_time") @db.VarChar(8)
  timezone      String              @default("Asia/Jakarta") @db.VarChar(32)
  consentedAt   DateTime?           @map("consented_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

model NotificationDelivery {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  dailyRecommendationId String              @map("daily_recommendation_id") @db.Uuid
  channel               NotificationChannel @default(WHATSAPP)
  providerMessageId     String?             @map("provider_message_id") @db.VarChar(128)
  status                DeliveryStatus      @default(PENDING)
  attemptCount          Int                 @default(0) @map("attempt_count")
  scheduledAt           DateTime            @map("scheduled_at") @db.Timestamptz(6)
  sentAt                DateTime?           @map("sent_at") @db.Timestamptz(6)
  deliveredAt           DateTime?           @map("delivered_at") @db.Timestamptz(6)
  errorCode             String?             @map("error_code") @db.VarChar(64)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRecommendation DailyRecommendation @relation(fields: [dailyRecommendationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scheduledAt])
  @@index([userId])
  @@index([dailyRecommendationId])
  @@map("notification_deliveries")
}

// -------------------------------------------------------------
// NUTRIHELP — OPEN DONATION CAMPAIGNS
// -------------------------------------------------------------

model HelpCampaign {
  id                    String           @id @default(uuid()) @db.Uuid
  creatorUserId         String           @map("creator_user_id") @db.Uuid
  category              CampaignCategory
  applicantName         String           @map("applicant_name") @db.VarChar(255)
  recipientName         String           @map("recipient_name") @db.VarChar(255)
  whatsappNumber        String           @map("whatsapp_number") @db.VarChar(32)
  relationship          String           @db.VarChar(64)
  province              String           @db.VarChar(100)
  city                  String           @db.VarChar(100)
  title                 String           @db.VarChar(255)
  story                 String           @db.Text
  healthConditionDesc   String           @map("health_condition_desc") @db.Text
  economicConditionDesc String           @map("economic_condition_desc") @db.Text
  targetAmount          Decimal          @map("target_amount") @db.Decimal(12, 2)
  durationDays          Int              @map("duration_days")
  thumbnailUrl          String?          @map("thumbnail_url") @db.Text
  documents             Json?
  status                CampaignStatus   @default(REVIEW)
  adminNote             String?          @map("admin_note") @db.Text
  submittedAt           DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  publishedAt           DateTime?        @map("published_at") @db.Timestamptz(6)
  deadlineAt            DateTime?        @map("deadline_at") @db.Timestamptz(6)
  endedAt               DateTime?        @map("ended_at") @db.Timestamptz(6)
  endReason             String?          @map("end_reason") @db.VarChar(32)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  creator   User             @relation("UserCampaigns", fields: [creatorUserId], references: [id], onDelete: Restrict)
  items     CampaignItem[]
  reviews   CampaignReview[]
  donations Donation[]

  @@index([status])
  @@index([category])
  @@index([creatorUserId])
  @@map("help_campaigns")
}

model CampaignItem {
  id            String  @id @default(uuid()) @db.Uuid
  campaignId    String  @map("campaign_id") @db.Uuid
  name          String  @db.VarChar(255)
  quantity      String  @db.VarChar(64)
  estimatedCost Decimal @map("estimated_cost") @db.Decimal(12, 2)
  sortOrder     Int     @default(0) @map("sort_order")

  // Relations
  campaign HelpCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_items")
}

model CampaignReview {
  id          String         @id @default(uuid()) @db.Uuid
  campaignId  String         @map("campaign_id") @db.Uuid
  adminUserId String         @map("admin_user_id") @db.Uuid
  decision    ReviewDecision
  note        String?        @db.Text
  checklist   Json?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  campaign  HelpCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adminUser User         @relation("AdminReviews", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([adminUserId])
  @@map("campaign_reviews")
}

// -------------------------------------------------------------
// NUTRIASSIST — QRIS DONATIONS
// -------------------------------------------------------------

model Donation {
  id                 String         @id @db.VarChar(32) // Reference code, e.g. "NM-MD3K9A"
  campaignId         String         @map("campaign_id") @db.Uuid
  donorUserId        String?        @map("donor_user_id") @db.Uuid
  amount             Decimal        @db.Decimal(12, 2)
  donorName          String         @map("donor_name") @db.VarChar(255)
  isAnonymous        Boolean        @default(false) @map("is_anonymous")
  message            String?        @db.Text
  paymentMethod      String         @default("QRIS") @map("payment_method") @db.VarChar(32)
  status             DonationStatus @default(PENDING_PAYMENT)
  paymentSubmittedAt DateTime?      @map("payment_submitted_at") @db.Timestamptz(6)
  verifiedBy         String?        @map("verified_by") @db.Uuid
  verifiedAt         DateTime?      @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  campaign      HelpCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donorUser     User?        @relation("DonorDonations", fields: [donorUserId], references: [id], onDelete: SetNull)
  verifierAdmin User?        @relation("AdminVerifiedDonations", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([status])
  @@index([paymentSubmittedAt])
  @@map("donations")
}

// -------------------------------------------------------------
// NUTRIWALLET & WITHDRAWALS (FINANCIAL LEDGER)
// -------------------------------------------------------------

model Wallet {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(255)
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  withdrawals  Withdrawal[]

  @@map("wallets")
}

model WalletTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  walletId        String                @map("wallet_id") @db.Uuid
  transactionType WalletTransactionType @map("transaction_type")
  amount          Decimal               @db.Decimal(12, 2)
  referenceType   String                @map("reference_type") @db.VarChar(32) // "DONATION" | "WITHDRAWAL"
  referenceId     String                @map("reference_id") @db.VarChar(64) // polymorphic reference key
  description     String                @db.Text
  balanceAfter    Decimal               @map("balance_after") @db.Decimal(12, 2)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  // Financial Idempotency Safeguard:
  // Note: PostgreSQL cannot enforce cross-table foreign keys polymorphically
  // on reference_id based on reference_type. Application logic and database transactions
  // enforce consistency while this unique constraint strictly prevents duplicate credit or debit.
  @@unique([referenceType, referenceId], name: "uq_wallet_tx_reference")
  @@index([walletId])
  @@map("wallet_transactions")
}

model Withdrawal {
  id              String           @id @db.VarChar(32) // Reference code, e.g. "WD-20261018-01"
  walletId        String           @map("wallet_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  bankName        String           @map("bank_name") @db.VarChar(128)
  accountNumber   String           @map("account_number") @db.VarChar(32)
  accountHolder   String           @map("account_holder") @db.VarChar(255)
  amount          Decimal          @db.Decimal(12, 2)
  status          WithdrawalStatus @default(PENDING)
  processedBy     String?          @map("processed_by") @db.Uuid
  processedAt     DateTime?        @map("processed_at") @db.Timestamptz(6)
  rejectionReason String?          @map("rejection_reason") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  wallet    Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user      User   @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)
  processor User?  @relation("AdminProcessedWithdrawals", fields: [processedBy], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([userId])
  @@index([status])
  @@map("withdrawals")
}

// -------------------------------------------------------------
// HUBUNGI KAMI — CONTACT MESSAGES
// -------------------------------------------------------------

model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @db.VarChar(255)
  email     String               @db.VarChar(255)
  subject   String?              @db.VarChar(255)
  message   String               @db.Text
  status    ContactMessageStatus @default(UNREPLIED)
  replyText String?              @map("reply_text") @db.Text
  repliedAt DateTime?            @map("replied_at") @db.Timestamptz(6)
  repliedBy String?              @map("replied_by") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  replierAdmin User? @relation("AdminRepliedMessages", fields: [repliedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}
